# ============================================================================
# Simple Chatbot — Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values as needed.
# DO NOT commit `.env` to version control — it may contain personal paths,
# tokens, or per-machine overrides.
# ============================================================================

# ----------------------------------------------------------------------------
# Model
# ----------------------------------------------------------------------------
# HuggingFace model id used by the backend. The original capstone uses
# DeepHat-V1-7B (a Qwen2.5-Coder-7B finetune specialised in cybersecurity
# and DevOps). Swap this for any other causal LM that supports
# `tokenizer.apply_chat_template()` — e.g.:
#   HuggingFaceTB/SmolLM2-1.7B-Instruct
#   meta-llama/Meta-Llama-3-8B-Instruct
#   Qwen/Qwen2.5-7B-Instruct
CHATBOT_MODEL_NAME=DeepHat/DeepHat-V1-7B

# ----------------------------------------------------------------------------
# Compute
# ----------------------------------------------------------------------------
# Restrict the CUDA devices visible to PyTorch. Use a comma-separated list
# of GPU indices, or leave empty/unset to use all available GPUs.
#
# Examples:
#   CUDA_VISIBLE_DEVICES=         # use all GPUs (Accelerate shards the
#                                   model across them with device_map=auto)
#   CUDA_VISIBLE_DEVICES=0        # use only GPU 0
#   CUDA_VISIBLE_DEVICES=0,1      # use GPUs 0 and 1 (sharded inference)
#
# For a 7B BF16 model (~14 GB) you need ~16 GB of combined VRAM plus headroom
# for activations and the KV cache, so a single 24 GB card works, two 24 GB
# cards are comfortable, and 8-12 GB cards will OOM unless you quantise.
CUDA_VISIBLE_DEVICES=0,1

# ----------------------------------------------------------------------------
# Backend (FastAPI)
# ----------------------------------------------------------------------------
# Host the embedded FastAPI server binds to. Use 127.0.0.1 for local-only.
CHATBOT_BACKEND_HOST=127.0.0.1
# Port the embedded FastAPI server binds to.
CHATBOT_BACKEND_PORT=8000

# ----------------------------------------------------------------------------
# Frontend (Streamlit)
# ----------------------------------------------------------------------------
# Streamlit server host (passed to the embedded backend so CORS allows it).
CHATBOT_FRONTEND_HOST=localhost
# Streamlit server port.
CHATBOT_FRONTEND_PORT=8501

# ----------------------------------------------------------------------------
# Embedded-backend behaviour
# ----------------------------------------------------------------------------
# When 1, the Streamlit frontend will auto-start the FastAPI backend in a
# background thread if it is not already running. This gives the single-
# command workflow: `streamlit run frontend/app.py`.
# Set to 0 to run the backend in a separate terminal instead.
CHATBOT_EMBED_BACKEND=1
